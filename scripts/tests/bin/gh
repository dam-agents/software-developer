#!/usr/bin/env bash
# Stub gh: canned answers from the STUB_* variables, and a trace of every call.
echo "$*" >> "$STUB_DIR/gh.calls"
answer() { [ -n "$1" ] || exit 1; printf '%s\n' "$1"; }
case "$1 $2" in
  "pr list") [ -z "${STUB_PR_FAIL:-}" ] || exit 1; printf '%s' "${STUB_PRS:-[]}" ;;
  "pr view")
    if [ -n "${STUB_PR_VIEWS:-}" ]; then   # one answer per call, the last repeated
      n="$(cat "$STUB_DIR/pr.views" 2>/dev/null || echo 0)"; echo $((n + 1)) > "$STUB_DIR/pr.views"
      v="$(printf '%s\n' "$STUB_PR_VIEWS" | sed -n "$((n + 1))p")"
      [ -n "$v" ] || v="$(printf '%s\n' "$STUB_PR_VIEWS" | tail -1)"
      answer "$v"
    else answer "${STUB_PR_VIEW-}"; fi ;;
  "issue list")
    label=""; prev=""
    for a in "$@"; do [ "$prev" = "--label" ] && label="$a"; prev="$a"; done
    if [ "$label" = "${STUB_HANDOFF_LABEL:-agent/implement}" ]; then printf '%s' "${STUB_HANDOFF:-[]}"
    else printf '%s' "${STUB_CLAIMED:-[]}"; fi ;;
  "label list")
    answer "${STUB_LABELS-$(printf 'agent/implement\nagent/in-progress\nagent/failed\ncode-guardian-review\nagent/needs-info')}" ;;
  "api "*)
    shift; path=""; skip=""; head=""; etag=""
    for a in "$@"; do
      if [ -n "$skip" ]; then
        case "$skip:$a" in "-H:If-None-Match: "*) etag="${a#If-None-Match: }" ;; esac
        skip=""; continue
      fi
      case "$a" in -i) head=1 ;; --hostname | --jq | -q | -X | -H | -f | -F) skip="$a" ;; -*) ;; *) [ -n "$path" ] || path="$a" ;; esac
    done
    if [ -n "$head" ] && [ -n "$etag" ] && [ "$etag" = "${STUB_ETAG:-}" ]; then
      printf 'HTTP/2.0 304 Not Modified\r\nEtag: %s\r\n\r\n' "$etag"; exit 1
    fi
    rest() { [ -z "${STUB_REST_FAIL:-}" ] || exit 1; answer "$1"; }
    body="$(case "$path" in
      graphql)
      if [ -n "${STUB_PR_FAIL:-}${STUB_GRAPHQL_FAIL:-}" ]; then
        echo "GraphQL: API rate limit exceeded for installation ID 1." >&2; exit 1
      fi
      # the fixtures are in `gh --json` shape; answer in the shape the query asks
      jq -n --argjson prs "${STUB_PRS:-[]}" --argjson handoff "${STUB_HANDOFF:-[]}" --argjson claimed "${STUB_CLAIMED:-[]}" '
        {data: {
          prs: {nodes: [$prs[] | . + {latestReviews: {nodes: (.latestReviews // [])},
            commits: {nodes: [{commit: {statusCheckRollup: {contexts: {nodes: [(.statusCheckRollup // [])[]
              | if .context then {context, state, createdAt: .startedAt} else . end]}}}}]}} | del(.statusCheckRollup)]},
          repository: {handoff: {nodes: [$handoff[] | .labels = {nodes: .labels}]}, claimed: {nodes: $claimed}}}}' ;;
      user) answer "${STUB_LOGIN-dev-bot}" ;;
      installation/repositories*) answer "${STUB_INSTALLATION-}" ;;
      user/repos*) answer "${STUB_REACH-1}" ;;
      repos/*/contents/*) answer "${STUB_BACKUP_CONFIG-}" ;;
      repos/*/issues/*/comments*) answer "${STUB_COMMENTS-[]}" ;;
      repos/*/issues"?"*)
        case "$path" in *"labels=$(jq -rn --arg l "${STUB_HANDOFF_LABEL:-agent/implement}" '$l | @uri')"*) v="${STUB_HANDOFF:-[]}" ;; *) v="${STUB_CLAIMED:-[]}" ;; esac
        rest "$(printf '%s' "$v" | jq 'map(. + {html_url: .url})')" ;;
      repos/*/pulls"?"*) [ -z "${STUB_PR_FAIL:-}" ] || exit 1; rest "${STUB_REST_PULLS-[]}" ;;
      repos/*/pulls/*/reviews*) rest "${STUB_REVIEWS-[]}" ;;
      repos/*/commits/*/check-runs*) rest "${STUB_CHECKS-{\"check_runs\":[]\}}" ;;
      repos/*/commits/*/status*) rest "${STUB_COMBINED-{\"statuses\":[]\}}" ;;
      repos/*/pulls/*) answer "${STUB_PULL-}" ;;
      repos/*/issues/*) answer "${STUB_ISSUE-}" ;;
      repos/*-work) answer "${STUB_WORK_PUSH-true}" ;;
      repos/*) answer "${STUB_PUSH-true}" ;;
      *) echo "stub gh: unexpected api $path" >&2; exit 9 ;;
    esac)" || exit $?
    [ -z "$head" ] || printf 'HTTP/2.0 200 OK\r\nEtag: %s\r\n\r\n' "${STUB_ETAG:-}"
    printf '%s\n' "$body" ;;
  *) echo "stub gh: unexpected $*" >&2; exit 9 ;;
esac
