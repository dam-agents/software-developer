#!/usr/bin/env bash
# Stub curl: the runtime. sessions.list answers from STUB_RUNNING (the session
# ids running a turn), STUB_CHATS (the direct sessions) and STUB_SLACK (Slack
# sessions; any other is a schedule_cron); /api/status from STUB_STATUS. STUB_RUNTIME_DOWN=1 is a
# runtime that does not answer.
[ -z "${STUB_RUNTIME_DOWN:-}" ] || exit 7
url=""; sid=""
for a in "$@"; do
  case "$a" in
    http*) url="$a" ;;
    input=*) sid="$(printf '%s' "${a#input=}" | sed -n 's/.*"sessionId":"\([^"]*\)".*/\1/p')" ;;
  esac
done
case "$url" in
  */api/trpc/sessions.list*)
    type=schedule_cron; case " ${STUB_CHATS:-} " in *" $sid "*) type=regular ;; esac
    case " ${STUB_SLACK:-} " in *" $sid "*) type=channel_slack ;; esac
    running=false; case " ${STUB_RUNNING:-} " in *" $sid "*) running=true ;; esac
    if [ "$running" = true ] || [ "$type" != schedule_cron ]; then
      printf '{"result":{"data":{"sessions":[{"sessionId":"%s","running":%s,"type":"%s"}]}}}' "$sid" "$running" "$type"
    else printf '{"result":{"data":{"sessions":[]}}}'; fi ;;
  */api/status) [ -n "${STUB_STATUS:-}" ] || exit 7; printf '%s' "$STUB_STATUS" ;;
  *) exit 7 ;;
esac
